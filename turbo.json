{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "outputs": []
    },
    "test:c": {
      "outputs": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:ui": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "check-types": {
      "outputs": []
    },
    "prettier": {
      "outputs": []
    },
    "prettier:w": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PLAYGROUND_API_TARGET"
      ]
    },
    "dev:missing-manifest": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "dev:invalid-manifest": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "serve": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "bundle:local": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "outputs": [
        "storybook-static/**"
      ]
    }
  }
}
