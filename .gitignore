coverage/
.nyc_output/
test-results/
playwright-report/

# Generated internal tooling output
internal/**/*.js
internal/**/*.js.map
internal/**/*.d.ts
!internal/**/*.cjs

# Operating system files
.DS_Store
/ToDo.md
/test.txt
