{
    "name": "@wesflo/local-mock-api-demo",
    "version": "0.0.1",
    "private": true,
    "description": "",
    "main": "src/index.ts",
    "scripts": {
        "cleanViteCache": "rm -rf node_modules/.vite",
        "dev": "pnpm run cleanViteCache && vite --config=vite.config.mjs",
        "dev:missing-manifest": "pnpm run cleanViteCache && vite --config=vite.config.mjs --mode missing-manifest",
        "dev:invalid-manifest": "pnpm run cleanViteCache && vite --config=vite.config.mjs --mode invalid-manifest",
        "build": "rm -rf ./dist && vite build --config=vite.config.mjs",
        "serve": "http-server ./dist -p 5001 --cors='*'",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:c": "vitest run --coverage --passWithNoTests",
        "test:ui": "vitest --ui",
        "lint": "eslint .",
        "lint:fix": "eslint --ext .js,.ts  --fix",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "prettier": "prettier -c --config ./prettier.config.mjs ./src",
        "prettier:w": "prettier -w --config ./prettier.config.mjs ./src"
    },
    "dependencies": {
        "@wesflo/local-mock-api-ui": "workspace:*",
        "@wesflo/local-mock-api-utils": "workspace:*",
        "@wesflo/wf-vite-mock-proxy": "workspace:*",
        "@wesflo/vite-plugin-local-mock-api": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "@types/jest": "^29.5.14",
        "eslint": "9.39.4",
        "eslint-plugin-vitest-globals": "^1.5.0",
        "globals": "^16.0.0",
        "lit": "^3.3.1",
        "prettier": "3.8.1",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.27.0",
        "vite": "8.2.2",
        "vitest": "^4.1.11"
    },
    "eslintConfig": {
        "extends": "./eslint.config.mjs"
    },
    "prettier": "./prettier.config.mjs",
    "engines": {
        "node": ">=24 <25",
        "pnpm": ">=11 <12"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wesflo/vite-plugin-local-mock-api.git"
    },
    "keywords": [
        "empty",
        "project"
    ],
    "author": "ep",
    "license": "ISC",
    "files": [
        "dist"
    ],
    "bugs": {
        "url": "https://github.com/wesflo/vite-plugin-local-mock-api/issues"
    },
    "homepage": "https://github.com/wesflo/vite-plugin-local-mock-api#readme"
}
