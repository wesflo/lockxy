        "directory": "packages/wf-vite-mock-proxy"
    },
    "homepage": "https://wesflo.github.io/vite-plugin-local-mock-api/proxy-panel/",
    "bugs": {
        "url": "https://github.com/wesflo/vite-plugin-local-mock-api/issues"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
