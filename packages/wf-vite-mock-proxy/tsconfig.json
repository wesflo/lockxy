{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "lib": ["ES2022", "DOM"],
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "skipLibCheck": true,
        "types": ["vitest/globals"]
    },
    "include": ["src/**/*.ts", "vite.config.ts"],
    "exclude": ["dist", "node_modules"]
}
