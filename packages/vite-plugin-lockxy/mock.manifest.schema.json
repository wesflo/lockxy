{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://wesflo.github.io/lockxy/schema/mock.manifest.schema.json",
    "title": "Lockxy manifest",
    "description": "Optional behavior overrides for @wesflo/vite-plugin-lockxy.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Stable project identifier used to namespace optional panel storage."
        },
        "preventMock": {
            "type": "boolean",
            "description": "When true, all matching requests pass through to the next Vite middleware."
        },
        "delay": { "$ref": "#/$defs/delay" },
        "endpoints": {
            "type": "array",
            "items": { "$ref": "#/$defs/endpoint" }
        }
    },
    "$defs": {
        "delay": {
            "description": "A fixed delay or inclusive random delay range in milliseconds.",
            "oneOf": [
                { "type": "integer", "minimum": 0 },
                {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                        { "type": "integer", "minimum": 0 },
                        { "type": "integer", "minimum": 0 }
                    ],
                    "items": false
                }
            ]
        },
        "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
        },
        "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$",
            "description": "Response file relative to mockRoot."
        },
        "response": {
            "type": "object",
            "properties": {
                "status": { "$ref": "#/$defs/status" },
                "delay": { "$ref": "#/$defs/delay" },
                "file": { "$ref": "#/$defs/file" }
            }
        },
        "scenario": {
            "allOf": [
                { "$ref": "#/$defs/response" },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                        "label": { "type": "string", "minLength": 1 },
                        "active": {
                            "type": "boolean",
                            "description": "Opts the endpoint into manifest-controlled scenario selection. The first true scenario wins; when none are true, the request passes through."
                        },
                        "status": { "$ref": "#/$defs/status" },
                        "delay": { "$ref": "#/$defs/delay" },
                        "file": { "$ref": "#/$defs/file" }
                    }
                }
            ]
        },
        "endpoint": {
            "allOf": [
                { "$ref": "#/$defs/response" },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path"],
                    "properties": {
                        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                        "label": { "type": "string", "minLength": 1 },
                        "preventMock": {
                            "type": "boolean",
                            "description": "When true, this endpoint passes through to the next Vite middleware."
                        },
                        "method": {
                            "oneOf": [
                                { "type": "string", "minLength": 1 },
                                {
                                    "type": "array",
                                    "minItems": 1,
                                    "uniqueItems": true,
                                    "items": { "type": "string", "minLength": 1 }
                                }
                            ]
                        },
                        "path": { "type": "string", "pattern": "^/" },
                        "status": { "$ref": "#/$defs/status" },
                        "delay": { "$ref": "#/$defs/delay" },
                        "file": { "$ref": "#/$defs/file" },
                        "scenarios": {
                            "type": "array",
                            "minItems": 1,
                            "items": { "$ref": "#/$defs/scenario" }
                        }
                    }
                }
            ]
        }
    }
}
