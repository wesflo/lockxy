{
    "name": "@wesflo/vite-plugin-local-mock-api",
    "version": "0.0.0",
    "description": "The Lockxy Vite plugin for serving a local mock API.",
    "author": {
        "name": "Florian Wessner",
        "email": "lockxy@wesflo.de"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wesflo/vite-plugin-local-mock-api.git",
        "directory": "packages/vite-plugin-local-mock-api"
    },
    "homepage": "https://wesflo.github.io/vite-plugin-local-mock-api/",
    "bugs": {
        "url": "https://github.com/wesflo/vite-plugin-local-mock-api/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./mock.manifest.schema.json": "./mock.manifest.schema.json"
    },
    "files": [
        "dist",
        "mock.manifest.schema.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "rm -rf ./dist && vite build && tsc -p tsconfig.build.json",
        "bundle:local": "pnpm run build && pnpm pack",
        "dev": "vitest src --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run src",
        "test:watch": "vitest src",
        "prettier": "prettier -c --config ../../prettier.config.mjs ./src",
        "prettier:w": "prettier -w --config ../../prettier.config.mjs ./src",
        "test:c": "vitest run src --coverage --passWithNoTests",
        "check-types": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@wesflo/local-mock-api-utils": "workspace:*",
        "@eslint/js": "^9.23.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.13",
        "@typescript-eslint/eslint-plugin": "^8.27.0",
        "@typescript-eslint/parser": "^8.27.0",
        "eslint": "9.39.4",
        "eslint-plugin-vitest-globals": "^1.5.0",
        "eslint-plugin-import": "2.31.0",
        "globals": "^16.0.0",
        "happy-dom": "^20.13.1",
        "lint-staged": "15.2.10",
        "prettier": "3.8.1",
        "types-package-json": "^2.0.39",
        "tslib": "2.8.1",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.27.0",
        "vite": "8.2.2",
        "vite-plugin-banner": "0.8.1",
        "vitest": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
